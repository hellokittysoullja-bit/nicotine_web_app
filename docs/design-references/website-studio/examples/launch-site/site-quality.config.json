  "routes": [
    {
      "path": "/",
      "file": "index.html",
      "requiredText": ["Talk less. Move more.", "fictional Website Studio example"],
      "expectedAnonymousStatuses": [200]
    }
  ],
  "requiredFiles": ["index.html"],
